# Patient Flow Orchestrator — environment
# Copy to .env and fill in. Never commit a real .env.

# Hosted Claude (default reasoning provider). Leave blank when using --profile local.
ANTHROPIC_API_KEY=

# Where the app reaches the OpenCode harness (opencode serve)
OPENCODE_URL=http://localhost:4096

# Where the tools reach the simulator's HTTP surface
SIM_URL=http://localhost:3000/api/sim

# Scenario + seed — the same pair always replays an identical day
SCENARIO=normal-weekday   # or: flu-surge
SEED=42
