# Patient Flow Orchestrator — environment
# Copy to .env and fill in. Never commit a real .env.

# Reasoning provider. The default model (opencode/big-pickle, OpenCode Zen free tier)
# needs no key. Set this only if you swap the agents to a hosted Claude (anthropic/*) model.
ANTHROPIC_API_KEY=

# Where the app reaches the OpenCode harness (opencode serve)
OPENCODE_URL=http://localhost:4096

# The harness server binds 0.0.0.0 in Docker — set a password (HTTP basic auth).
# Leave blank for local-only use; required if the port is reachable beyond localhost.
OPENCODE_SERVER_PASSWORD=


# Where the tools reach the simulator's HTTP surface
SIM_URL=http://localhost:3000/api/sim

# Scenario + seed — the same pair always replays an identical day.
# Scenario options: normal-weekday | flu-surge
SCENARIO=normal-weekday
SEED=42


# --- Authentication (Better Auth + SQLite/Drizzle) ---

# Strong random secret used to sign session cookies. Generate one, e.g.:
#   openssl rand -base64 32
# Required — the server refuses to start without it.
BETTER_AUTH_SECRET=

# The public HTTPS URL the app is served from (behind the Cloudflare Tunnel).
# Used as the auth base URL and the CSRF Origin/Referer check target.
BETTER_AUTH_URL=http://localhost:3000

# SQLite file for the auth store. A path on a mounted volume in deployment so
# accounts + sessions survive a container restart.
AUTH_DB_PATH=./auth.db

# Bootstrap password for the seeded `superadmin` account (0.5.0). Optional: if unset,
# the seed generates a random one and prints it ONCE to stdout. Never committed, and
# never shown on the login screen. The seed also mints 50 invite keys to a gitignored
# .invite-keys.txt for onboarding viewer/coordinator accounts.
SUPERADMIN_PASSWORD=
